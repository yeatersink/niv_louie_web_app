# Copy this file to .env and replace the placeholders.
# .env is gitignored. Do not commit real secrets.

# NiceGUI session storage secret. Required when DOCKER or RUNNING_IN_DOCKER is set.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
STORAGE_SECRET=

# SMTP account used by utils/email.py
SMTP_EMAIL=
# SMTP password or app password used by utils/email.py
SMTP_PASSWORD=
# SMTP host. Gmail submission uses smtp.gmail.com.
SMTP_SERVER=smtp.gmail.com
# SMTP submission port.
SMTP_PORT=587
