# .gitignore for Niv Louie Web App

# Environment variables - NEVER commit this!
.env

# Python cache and compiled files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Docker
*.log

# NiceGUI / temporary files
.nicegui/
storage-user-*.json

# Logs
*.log
logs/

# Build artifacts
dist/
build/
*.egg-info/